# Exemplo de variaveis. Valores ficticios; NAO coloque segredos reais aqui.
# A aplicacao NAO le este arquivo automaticamente: exporte as variaveis no shell ou configure a IDE.
# NENHUMA destas variaveis e obrigatoria para iniciar a API nesta etapa (ha padroes para as duas primeiras).

# Servidor HTTP (padroes: 0.0.0.0 e 8080)
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Oracle da faculdade: host oracle.fiap.com.br, porta 1521, SID orcl (formato com ':' antes do SID).
# Usuario e senha: coloque so no seu .env local (ignorado pelo git).
DB_URL=jdbc:oracle:thin:@oracle.fiap.com.br:1521:orcl
DB_USERNAME=
DB_PASSWORD=

# Sessao de login (RC-04): validade em minutos, de 1 a 1440 (padrao 30). Opcional.
SESSION_TTL_MINUTES=30

# Testes que usam o Oracle real (RC-04): so rodam se DB_* estiverem exportadas E esta variavel for SIM.
# Sem ela, esses testes sao ignorados e devem ser registrados como NAO VERIFICADOS.
RC_TESTE_ORACLE=

# Chave do simulador de sensores (RC-05): opcional para iniciar; sem ela a telemetria responde 401.
# Enviada no cabecalho X-Chave-Simulador; so vale na rota de telemetria. Coloque o valor so no .env local.
IOT_API_KEY=

# Area privada de arquivos (RC-06): pasta FORA do repositorio e de qualquer pasta publica, so no seu .env local.
# Opcional para iniciar: sem ela a API sobe, a conferencia de arquivos funciona e guardar arquivo falha com 503.
DOCUMENT_STORAGE_PATH=

# Endereco pelo qual o app alcanca a API na demonstracao remota (RC-06). Opcional.
# Se for remoto precisa ser https://...; a API NAO inicia com http remoto. http so em localhost, 127.0.0.1 e 10.0.2.2.
API_PUBLIC_URL=
