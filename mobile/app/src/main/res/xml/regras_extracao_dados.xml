<?xml version="1.0" encoding="utf-8"?>
<!-- A sessão (SharedPreferences "sessao") nunca entra em backup nem em transferência entre aparelhos. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
