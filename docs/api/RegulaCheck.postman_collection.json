{
  "info": {
    "name": "RegulaCheck - fundacao e autenticacao",
    "description": "Dados sinteticos. Defina a variavel senhaDemo com a senha de demonstracao fictícia de database/scripts/README.md (nao a versione preenchida).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "email",
      "value": "paciente.a@exemplo.invalid"
    },
    {
      "key": "senhaDemo",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "chaveSimulador",
      "value": ""
    },
    {
      "key": "solicitacaoId",
      "value": ""
    },
    {
      "key": "documentoId",
      "value": ""
    },
    {
      "key": "chaveEnvio",
      "value": "7d1c1b8e-9f2a-4c3e-8a10-aa11bb22cc33"
    },
    {
      "key": "chaveTroca",
      "value": "3f9a2c1d-6b7e-4d80-9c11-0a1b2c3d4e5f"
    },
    {
      "key": "extracaoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health tecnico",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Login (200 com token; guarda em {{token}})",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) { pm.collectionVariables.set('token', pm.response.json().token); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{email}}\",\"senha\":\"{{senhaDemo}}\"}"
        }
      }
    },
    {
      "name": "Login com senha errada (401 CREDENCIAIS_INVALIDAS)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{email}}\",\"senha\":\"senha-errada\"}"
        }
      }
    },
    {
      "name": "Sessao atual (200; 401 NAO_AUTENTICADO sem sessao)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/auth/sessao"
      }
    },
    {
      "name": "Logout (204)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/auth/logout"
      }
    },
    {
      "name": "Sessao com chave do simulador em rota de conta (403 ACESSO_NEGADO)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Chave-Simulador",
            "value": "{{chaveSimulador}}"
          }
        ],
        "url": "{{baseUrl}}/auth/sessao"
      }
    },
    {
      "name": "RC-07 Servicos disponiveis (200; 403 para administrador)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/protocolos"
      }
    },
    {
      "name": "RC-07 Criar rascunho (201 com Location; guarda em {{solicitacaoId}})",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) { pm.collectionVariables.set('solicitacaoId', pm.response.json().id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes",
        "body": {
          "mode": "raw",
          "raw": "{\"protocoloId\":\"PROTOCOLO-ACADEMICO-FICTICIO-v0.1\"}"
        }
      }
    },
    {
      "name": "RC-07 Criar rascunho com servico inexistente (422 REGRA_DE_NEGOCIO)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes",
        "body": {
          "mode": "raw",
          "raw": "{\"protocoloId\":\"NAO-EXISTE-v1\"}"
        }
      }
    },
    {
      "name": "RC-07 Meus pedidos (200; ate 50, mais recentes primeiro)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes"
      }
    },
    {
      "name": "RC-07 Reabrir pedido (200; 404 se for de outra paciente ou nao existir)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes/{{solicitacaoId}}"
      }
    },
    {
      "name": "RC-07 Trocar servico do rascunho (200; revisao +1 se mudou; 409 se ja saiu de RASCUNHO)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes/{{solicitacaoId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"protocoloId\":\"PROTOCOLO-ACADEMICO-FICTICIO-v0.1\"}"
        }
      }
    },
    {
      "name": "RC-08 Enviar documento (201 com Location; guarda em {{documentoId}}; repetir com a mesma chave devolve 200 sem duplicar)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) { pm.collectionVariables.set('documentoId', pm.response.json().id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "X-Chave-Envio",
            "value": "{{chaveEnvio}}"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes/{{solicitacaoId}}/documentos",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "tipoDocumental",
              "value": "ENCAMINHAMENTO",
              "type": "text"
            },
            {
              "key": "arquivo",
              "type": "file",
              "src": []
            }
          ]
        },
        "description": "Escolha um PDF, JPEG ou PNG sintetico no campo arquivo. O pedido precisa estar em RASCUNHO."
      }
    },
    {
      "name": "RC-08 Enviar documento com tipo documental invalido (400 REQUISICAO_INVALIDA, campo tipoDocumental)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes/{{solicitacaoId}}/documentos",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "tipoDocumental",
              "value": "LAUDO_INVENTADO",
              "type": "text"
            },
            {
              "key": "arquivo",
              "type": "file",
              "src": []
            }
          ]
        }
      }
    },
    {
      "name": "RC-08 Meus documentos do pedido (200; lista vazia tambem e 200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes/{{solicitacaoId}}/documentos"
      }
    },
    {
      "name": "RC-08 Baixar documento (200 como anexo; 404 se for de outra paciente, de outro pedido ou nao existir)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes/{{solicitacaoId}}/documentos/{{documentoId}}"
      }
    },
    {
      "name": "RC-09 Remover documento (200 com a versao nova e documentosDisponiveis; repetir e 404)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes/{{solicitacaoId}}/documentos/{{documentoId}}",
        "description": "Sem corpo. Revisao +1 (DOCUMENTO_REMOVIDO); o arquivo e apagado; a vaga volta. Pedido em SUBMETIDA_SIMULACAO responde 409."
      }
    },
    {
      "name": "RC-09 Substituir documento (201 com Location do documento NOVO e guarda em {{documentoId}}; repetir com a mesma chave devolve 200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) { pm.collectionVariables.set('documentoId', pm.response.json().id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "X-Chave-Envio",
            "value": "{{chaveTroca}}"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes/{{solicitacaoId}}/documentos/{{documentoId}}",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "tipoDocumental",
              "value": "ENCAMINHAMENTO",
              "type": "text"
            },
            {
              "key": "arquivo",
              "type": "file",
              "src": []
            }
          ]
        },
        "description": "Escolha um PDF, JPEG ou PNG sintetico no campo arquivo. Uma revisao (DOCUMENTO_SUBSTITUIDO); a contagem nao muda. Arquivo recusado deixa o antigo intacto."
      }
    },
    {
      "name": "RC-09 Substituir documento com arquivo invalido (415/400; o documento antigo continua igual)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes/{{solicitacaoId}}/documentos/{{documentoId}}",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "tipoDocumental",
              "value": "OUTRO",
              "type": "text"
            },
            {
              "key": "arquivo",
              "type": "file",
              "src": []
            }
          ]
        },
        "description": "Escolha, por exemplo, um .txt renomeado para .pdf."
      }
    },
    {
      "name": "RC-09 Excluir rascunho SEM confirmacao (400 REQUISICAO_INVALIDA, campo confirmacao; nada e apagado)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes/{{solicitacaoId}}"
      }
    },
    {
      "name": "RC-09 Excluir rascunho com confirmacao (204; apaga pedido, revisoes, documentos e arquivos; so RASCUNHO)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "X-Confirmar-Exclusao",
            "value": "EXCLUIR"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes/{{solicitacaoId}}",
        "description": "Irreversivel. Pedido submetido em simulacao responde 409 CONFLITO_ESTADO; fora de rascunho, 409 \"Somente rascunhos podem ser excluidos.\""
      }
    },
    {
      "name": "RC-10 Ler documentos do pedido (201 nova leitura SIMULADA; 200 se ja existe para a versao; 422 sem documentos)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes/{{solicitacaoId}}/extracoes",
        "description": "Sem corpo. Leitura simulada com dados sinteticos (simulada: true). Nao altera o estado do pedido, nao gera analise nem resultado de completude. Pedido em SUBMETIDA_SIMULACAO responde 409."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201 || pm.response.code === 200) { pm.collectionVariables.set('extracaoId', pm.response.json().id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "RC-10 Consultar leitura do pedido (200 ATUAL ou DESATUALIZADA; 404 se nunca houve leitura)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes/{{solicitacaoId}}/extracoes",
        "description": "Devolve a leitura mais recente. Depois de remover ou substituir documento, a leitura anterior fica DESATUALIZADA."
      }
    },
    {
      "name": "RC-11 Consultar conferencia da leitura (200 com situacao calculada; liberadoParaSubmissao sempre false; 404 se o pedido ou a leitura nao for da paciente)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes/{{solicitacaoId}}/extracoes/{{extracaoId}}/conferencia",
        "description": "Mostra o que foi lido (SIMULADO) com origem, destaca campos nao verificados e traz orientacoes fixas. Leitura desatualizada volta como DESATUALIZADA, somente leitura. Nao altera estado nem revisao."
      }
    },
    {
      "name": "RC-11 Confirmar um campo (200 com a decisao; decidir de novo substitui; repetir a mesma nao muda nada)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes/{{solicitacaoId}}/extracoes/{{extracaoId}}/conferencia",
        "body": {
          "mode": "raw",
          "raw": "{\"decisoes\":[{\"documentoId\":\"{{documentoId}}\",\"codigo\":\"NOME\",\"decisao\":\"CONFIRMADA\"}]}"
        },
        "description": "A paciente so confirma ou marca divergencia. Corpo fechado: documentoId, codigo, decisao e motivo."
      }
    },
    {
      "name": "RC-11 Marcar divergencia (200; motivo obrigatorio: VALOR_DIFERENTE_DO_DOCUMENTO em campo identificado, CAMPO_EXISTE_E_NAO_FOI_LIDO em campo nao localizado)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes/{{solicitacaoId}}/extracoes/{{extracaoId}}/conferencia",
        "body": {
          "mode": "raw",
          "raw": "{\"decisoes\":[{\"documentoId\":\"{{documentoId}}\",\"codigo\":\"DATA_EMISSAO\",\"decisao\":\"DIVERGENTE\",\"motivo\":\"VALOR_DIFERENTE_DO_DOCUMENTO\"}]}"
        },
        "description": "Divergencia nao troca o valor lido: a correcao de informacao e da unidade emissora."
      }
    },
    {
      "name": "RC-11 Tentar digitar valor (400 REQUISICAO_INVALIDA; nenhum valor digitado e aceito e nada e gravado)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes/{{solicitacaoId}}/extracoes/{{extracaoId}}/conferencia",
        "body": {
          "mode": "raw",
          "raw": "{\"decisoes\":[{\"documentoId\":\"{{documentoId}}\",\"codigo\":\"NOME\",\"decisao\":\"CONFIRMADA\",\"valor\":\"Outro Nome\"}]}"
        },
        "description": "Qualquer chave alem de documentoId, codigo, decisao e motivo e recusada."
      }
    },
    {
      "name": "RC-11 Decisao que nao cabe ao campo (422 DECISAO_NAO_APLICAVEL; ex.: confirmar campo nao localizado ou qualquer decisao em campo ilegivel)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes/{{solicitacaoId}}/extracoes/{{extracaoId}}/conferencia",
        "body": {
          "mode": "raw",
          "raw": "{\"decisoes\":[{\"documentoId\":\"{{documentoId}}\",\"codigo\":\"AUTORIZACAO_ASSINADA\",\"decisao\":\"CONFIRMADA\"}]}"
        },
        "description": "Lote tudo ou nada: nenhuma decisao do corpo e gravada. Leitura desatualizada responde 409 e pedido submetido tambem."
      }
    }
  ]
}
