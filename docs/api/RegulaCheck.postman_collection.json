{
  "info": {
    "name": "RegulaCheck - fundacao e autenticacao",
    "description": "Dados sinteticos. Defina a variavel senhaDemo com a senha de demonstracao fictícia de database/scripts/README.md (nao a versione preenchida).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "email",
      "value": "paciente.a@exemplo.invalid"
    },
    {
      "key": "senhaDemo",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "chaveSimulador",
      "value": ""
    },
    {
      "key": "solicitacaoId",
      "value": ""
    },
    {
      "key": "documentoId",
      "value": ""
    },
    {
      "key": "chaveEnvio",
      "value": "7d1c1b8e-9f2a-4c3e-8a10-aa11bb22cc33"
    }
  ],
  "item": [
    {
      "name": "Health tecnico",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Login (200 com token; guarda em {{token}})",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) { pm.collectionVariables.set('token', pm.response.json().token); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{email}}\",\"senha\":\"{{senhaDemo}}\"}"
        }
      }
    },
    {
      "name": "Login com senha errada (401 CREDENCIAIS_INVALIDAS)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{email}}\",\"senha\":\"senha-errada\"}"
        }
      }
    },
    {
      "name": "Sessao atual (200; 401 NAO_AUTENTICADO sem sessao)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/auth/sessao"
      }
    },
    {
      "name": "Logout (204)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/auth/logout"
      }
    },
    {
      "name": "Sessao com chave do simulador em rota de conta (403 ACESSO_NEGADO)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Chave-Simulador",
            "value": "{{chaveSimulador}}"
          }
        ],
        "url": "{{baseUrl}}/auth/sessao"
      }
    },
    {
      "name": "RC-07 Servicos disponiveis (200; 403 para administrador)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/protocolos"
      }
    },
    {
      "name": "RC-07 Criar rascunho (201 com Location; guarda em {{solicitacaoId}})",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) { pm.collectionVariables.set('solicitacaoId', pm.response.json().id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes",
        "body": {
          "mode": "raw",
          "raw": "{\"protocoloId\":\"PROTOCOLO-ACADEMICO-FICTICIO-v0.1\"}"
        }
      }
    },
    {
      "name": "RC-07 Criar rascunho com servico inexistente (422 REGRA_DE_NEGOCIO)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes",
        "body": {
          "mode": "raw",
          "raw": "{\"protocoloId\":\"NAO-EXISTE-v1\"}"
        }
      }
    },
    {
      "name": "RC-07 Meus pedidos (200; ate 50, mais recentes primeiro)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes"
      }
    },
    {
      "name": "RC-07 Reabrir pedido (200; 404 se for de outra paciente ou nao existir)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes/{{solicitacaoId}}"
      }
    },
    {
      "name": "RC-07 Trocar servico do rascunho (200; revisao +1 se mudou; 409 se ja saiu de RASCUNHO)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes/{{solicitacaoId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"protocoloId\":\"PROTOCOLO-ACADEMICO-FICTICIO-v0.1\"}"
        }
      }
    },
    {
      "name": "RC-08 Enviar documento (201 com Location; guarda em {{documentoId}}; repetir com a mesma chave devolve 200 sem duplicar)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) { pm.collectionVariables.set('documentoId', pm.response.json().id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "X-Chave-Envio",
            "value": "{{chaveEnvio}}"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes/{{solicitacaoId}}/documentos",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "tipoDocumental",
              "value": "ENCAMINHAMENTO",
              "type": "text"
            },
            {
              "key": "arquivo",
              "type": "file",
              "src": []
            }
          ]
        },
        "description": "Escolha um PDF, JPEG ou PNG sintetico no campo arquivo. O pedido precisa estar em RASCUNHO."
      }
    },
    {
      "name": "RC-08 Enviar documento com tipo documental invalido (400 REQUISICAO_INVALIDA, campo tipoDocumental)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes/{{solicitacaoId}}/documentos",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "tipoDocumental",
              "value": "LAUDO_INVENTADO",
              "type": "text"
            },
            {
              "key": "arquivo",
              "type": "file",
              "src": []
            }
          ]
        }
      }
    },
    {
      "name": "RC-08 Meus documentos do pedido (200; lista vazia tambem e 200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes/{{solicitacaoId}}/documentos"
      }
    },
    {
      "name": "RC-08 Baixar documento (200 como anexo; 404 se for de outra paciente, de outro pedido ou nao existir)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes/{{solicitacaoId}}/documentos/{{documentoId}}"
      }
    }
  ]
}
